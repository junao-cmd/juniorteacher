# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Instagram Graph API (conta Business/Creator ligada a uma Página do Facebook)
# Token de acesso de longa duração com instagram_basic, instagram_manage_insights, pages_read_engagement
INSTAGRAM_ACCESS_TOKEN=
# ID da conta do Instagram Business (não é o @). Veja o README para descobrir.
INSTAGRAM_USER_ID=
# Versão da Graph API
INSTAGRAM_GRAPH_VERSION=v23.0

# Modelo do Claude usado pelo agente
FURIA_AGENT_MODEL=claude-opus-5
